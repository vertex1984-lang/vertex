# 复制本文件为 .env.local 并按需修改
# VERTEX_ROOT：指向 vertex 仓库根目录（npm run import 从这里导入商品快照）
VERTEX_ROOT=D:\opencode_workspace\vertex
# SESSION_SECRET：登录会话签名密钥，任意随机字符串
SESSION_SECRET=change-me-to-a-random-string
# —— 订单状态 KV 发布（可选；不配则回退旧文件双写路径）——
# CF_API_TOKEN：Cloudflare API Token（有值才启用 KV 发布；令牌由管理员在 CF 后台创建，需 KV 写权限）
# CF_ACCOUNT_ID=29c026769c78d66267d0e8423f02a645
# ORDER_STATUS_KV_NAMESPACE=94afe8a5106e40fb8e52a5d5ea205962
# CF_API_BASE：默认官方 https://api.cloudflare.com/client/v4（仅联调/mock 时改）
