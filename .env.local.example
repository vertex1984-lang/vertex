# vertex 环境变量样例（复制为 .env.local 后按需填写；.env.local 不入库）

# Shopify Storefront（必需）
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_VERSION=2025-07

# GA4（批次 1+）：测量 ID 走环境变量；留空/不配置 = 全部事件 no-op、gtag 脚本不加载（零报错）
# 购买/退款事件只由 Shopify 原生 GA4 通道上报，站点侧代码不发（防双计）
NEXT_PUBLIC_GA_ID=

# AI 购物助手代理（可选；不配走脚本引擎兜底）
NEXT_PUBLIC_CHAT_LLM_ENABLED=true
NEXT_PUBLIC_CHAT_LLM_BASE_URL=http://localhost:8787

# 心愿单云 / 评价提交（批次 2/3）：指向 makimoo-admin 本地演示版的共享密钥接口
# （演示版两侧写死同一默认值；正式版换环境变量并评审鉴权方案）
NEXT_PUBLIC_WISHLIST_API=http://localhost:4200/api/wishlist
NEXT_PUBLIC_WISHLIST_TOKEN=makimoo-wishlist-demo-token
NEXT_PUBLIC_REVIEWS_API=http://localhost:4200/api/reviews
NEXT_PUBLIC_REVIEW_TOKEN=makimoo-review-demo-token
